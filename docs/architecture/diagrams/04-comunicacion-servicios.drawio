<mxfile host="app.diagrams.net" agent="CumbresBI-Architecture-Docs" version="24.0.0" type="device">
  <diagram id="comunicacion-v3" name="Comunicación entre Servicios (real, 17/Sep/2026)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="usr" value="Usuario" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="180" width="120" height="55" as="geometry" />
        </mxCell>
        <mxCell id="web" value="frontend (Next.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1C75BC;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="180" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="api-gateway&#10;(traduce cookie→Bearer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="180" width="160" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="Servicio A&#10;(ej. tesoreria-service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="90" width="190" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db1" value="Base MySQL&#10;del Servicio A" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="870" y="90" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="Servicio B&#10;(ej. drive-service / mail-service / audit-service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="630" y="290" width="270" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="1. Interacción UI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="usr" target="web"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2. HTTPS + cookie JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="web" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3. Authorization: Bearer &lt;jwt&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="gw" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="4. INSERT/UPDATE de negocio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="s1" target="db1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="5. requests.post(...) SÍNCRONO,&#10;best-effort: timeout corto + try/except" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="6. respuesta 200/erro — si falla o tarda,&#10;NO tumba la operación principal de A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="s2" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="7. respuesta HTTP normal" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="s1" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="note" value="No hay bus de eventos, Pub/Sub ni patrón saga (diseño original, nunca construido así). Toda la&#10;comunicación entre servicios es una llamada HTTP síncrona directa (librería requests de Python).&#10;La única distinción real es si la llamada es 'dura' (bloquea la operación si falla, ej. validar el&#10;JWT contra iam-service) o 'best-effort' (auditoría/correo/Drive — timeout corto + try/except,&#10;se degrada la función puntual pero la operación principal del usuario sigue funcionando)." style="text;html=1;align=left;fontStyle=2;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1000" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
