<mxfile host="app.diagrams.net" agent="CumbresBI-Architecture-Docs" version="24.0.0" type="device">
  <diagram id="flujo-auditoria-v3" name="Flujo de Auditoría (real, síncrono best-effort)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="a1" value="Servicio de negocio (cualquiera de los 12)&#10;procesa una acción sensible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="40" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Llama SÍNCRONO a audit-service&#10;(requests.post, timeout corto)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="125" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="try/except: si audit-service no responde&#10;o tarda, se registra el error pero&#10;NO se bloquea la operación del usuario" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="320" y="210" width="340" height="85" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="audit-service recibe la petición" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="320" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="INSERT append-only en bitacora_auditoria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="340" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="Visor de bitácora (iam-service/Admin):&#10;filtrable, exportable a CSV" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="480" width="340" height="55" as="geometry" />
        </mxCell>

        <mxCell id="reject1" value="Nadie puede editar/borrar una entrada&#10;ya escrita (ni Super Admin) — sin&#10;endpoint de UPDATE/DELETE expuesto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="720" y="400" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="riesgo" value="Riesgo real (aceptado, no un bug):&#10;si audit-service está caído,&#10;esa acción NUNCA queda en la&#10;bitácora — no hay cola/reintento,&#10;es fire-and-forget con timeout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="responde" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=9;" edge="1" parent="1" source="a3" target="a5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="a6" target="a7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="a6" target="reject1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="no responde/timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;strokeColor=#b85450;" edge="1" parent="1" source="a3" target="riesgo"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
