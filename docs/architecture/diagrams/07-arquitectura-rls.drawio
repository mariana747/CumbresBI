<mxfile host="app.diagrams.net" agent="CumbresBI-Architecture-Docs" version="24.0.0" type="device">
  <diagram id="arq-rls-v2" name="Arquitectura de RLS (Microservicios)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="login" value="Login OIDC / Magic Link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="iams" value="iam-service calcula EffectiveScope&#10;(GLOBAL/SOCIEDAD/PROYECTO + grants CENTRO/CONTRATO)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="135" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="jwt" value="JWT firmado RS256 (clave en Secret Manager)&#10;claims: is_global, sociedad_rfcs, proyecto_ids,&#10;centro_ids, contrato_ids — TTL ≈15 min" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="225" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="gw" value="API Gateway valida la firma del JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="320" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="Servicio de negocio: middleware DRF&#10;puebla request.effective_scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="405" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lib" value="Librería compartida 'cumbresbi-scope'&#10;ScopedManager / ScopedQuerySet — mismo mecanismo&#10;obligatorio del monolito, ahora versionado entre 13 servicios" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1C75BC;fontSize=10;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="495" width="320" height="65" as="geometry" />
        </mxCell>
        <mxCell id="q" value="Query SQL acotada dentro del&#10;esquema lógico propio del servicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1C75BC;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="590" width="320" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db" value="Esquema MySQL del servicio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="675" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="resp" value="Respuesta: solo filas dentro del alcance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="320" y="755" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="revoke" value="Pub/Sub: iam.scope.revocado&#10;(revocación forzada antes del TTL)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="720" y="215" width="220" height="85" as="geometry" />
        </mxCell>
        <mxCell id="riesgo" value="Riesgo introducido por el rediseño:&#10;versión desalineada de 'cumbresbi-scope'&#10;entre servicios = filtro de alcance&#10;inconsistente sin señal en runtime.&#10;Mitigación: CI bloquea despliegue&#10;si no cumple la 'floor version'." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="240" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="login" target="iams"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="iams" target="jwt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="jwt" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="gw" target="svc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc" target="lib"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="lib" target="q"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="q" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="db" target="resp"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="revocación forzada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="iams" target="revoke"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="invalida caché de claim" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="revoke" target="svc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="lib" target="riesgo"><mxGeometry relative="1" as="geometry" /></mxCell>
