<mxfile host="app.diagrams.net" agent="CumbresBI-Architecture-Docs" version="24.0.0" type="device">
  <diagram id="arq-general-v3" name="Arquitectura General (real, 17/Sep/2026)">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="u1" value="Usuarios internos&#10;(Google Workspace, cypcumbres.mx/.com)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="u2" value="Usuarios externos&#10;(Magic Link / ticket público)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="260" height="55" as="geometry" />
        </mxCell>

        <mxCell id="web" value="frontend (Next.js, Cloud Run)&#10;middleware.ts reenvía /iam/*, /pld/*, etc.&#10;server-to-server al Gateway (GATEWAY_INTERNAL_URL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#1C75BC;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="560" height="65" as="geometry" />
        </mxCell>

        <mxCell id="gw" value="api-gateway (Cloud Run, app Django propia)&#10;lee cookie JWT → la reenvía como Authorization: Bearer&#10;--allow-unauthenticated (único punto público real)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="560" height="65" as="geometry" />
        </mxCell>

        <mxCell id="micro" value="Microservicios de negocio (Cloud Run, 12) — llamadas HTTP síncronas directas&#10;iam · pld · vivienda · materiales · compras-tesoreria · tesoreria&#10;rrhh · rentas · obra · document-intelligence · drive · mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8eaed;strokeColor=#343741;fontSize=11;fontStyle=1;align=center" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="560" height="90" as="geometry" />
        </mxCell>

        <mxCell id="audits" value="audit-service&#10;bitácora inmutable (append-only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="245" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="db" value="Cloud SQL (MySQL) — 1 sola instancia&#10;db-cypcumbres, 1 base por servicio&#10;(cumbresbi_&lt;servicio&gt;), comparte instancia&#10;con el legacy 'administracion'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sm" value="Google Secret Manager&#10;(1 cuenta de servicio por microservicio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="oidc" value="Google Workspace OIDC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="ext" value="Gemini API (vía Vertex AI) / Google Drive API /&#10;Gmail API / Google Sheets API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="640" y="350" width="220" height="65" as="geometry" />
        </mxCell>

        <mxCell id="note" value="Sin bus de eventos ni Pub/Sub: toda la comunicación entre servicios es&#10;HTTP síncrono directo. Las llamadas no críticas (a audit-service, mail-service,&#10;drive-service) son 'best-effort' — timeout corto + try/except, nunca tumban&#10;la operación principal si el otro servicio tarda o falla." style="text;html=1;align=left;fontStyle=2;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="820" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="u1" target="web"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="u2" target="web"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="server-to-server (mismo origen para cookies)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="web" target="gw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="gw" target="micro"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="best-effort" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="micro" target="audits"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="micro" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" edge="1" parent="1" source="micro" target="sm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="Authorization Code + PKCE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="micro" target="oidc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="micro" target="ext"><mxGeometry relative="1" as="geometry" /></mxCell>
