# Copy to .env and fill in real values. Never commit the real .env.

# --- Django (shared defaults, override per service if needed) ---
DJANGO_SECRET_KEY=change-me-in-local-env
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,iam-service,audit-service,pld-service,document-intelligence-service,vivienda-service,compras-tesoreria-service,rrhh-service,tesoreria-service,rentas-service,drive-service,mail-service

# --- iam-service DB (MySQL) ---
IAM_DB_NAME=iam_service
IAM_DB_USER=iam_app
IAM_DB_PASSWORD=change-me
IAM_DB_ROOT_PASSWORD=change-me-root
IAM_DB_HOST=iam-db
IAM_DB_PORT=3306

# --- audit-service DB (MySQL) ---
AUDIT_DB_NAME=audit_service
AUDIT_DB_USER=audit_app
AUDIT_DB_PASSWORD=change-me
AUDIT_DB_ROOT_PASSWORD=change-me-root
AUDIT_DB_HOST=audit-db
AUDIT_DB_PORT=3306

# --- pld-service DB (MySQL) ---
PLD_DB_NAME=pld_service
PLD_DB_USER=pld_app
PLD_DB_PASSWORD=change-me
PLD_DB_ROOT_PASSWORD=change-me-root
PLD_DB_HOST=pld-service-db
PLD_DB_PORT=3306

# --- vivienda-service DB (MySQL) ---
VIVIENDA_DB_NAME=vivienda_service
VIVIENDA_DB_USER=vivienda_app
VIVIENDA_DB_PASSWORD=change-me
VIVIENDA_DB_ROOT_PASSWORD=change-me-root
VIVIENDA_DB_HOST=vivienda-service-db
VIVIENDA_DB_PORT=3306

# --- compras-tesoreria-service DB (MySQL) ---
COMPRAS_TESORERIA_DB_NAME=compras_tesoreria_service
COMPRAS_TESORERIA_DB_USER=compras_tesoreria_app
COMPRAS_TESORERIA_DB_PASSWORD=change-me
COMPRAS_TESORERIA_DB_ROOT_PASSWORD=change-me-root
COMPRAS_TESORERIA_DB_HOST=compras-tesoreria-service-db
COMPRAS_TESORERIA_DB_PORT=3306

# --- rrhh-service DB (MySQL) ---
RRHH_DB_NAME=rrhh_service
RRHH_DB_USER=rrhh_app
RRHH_DB_PASSWORD=change-me
RRHH_DB_ROOT_PASSWORD=change-me-root
RRHH_DB_HOST=rrhh-service-db
RRHH_DB_PORT=3306

# --- tesoreria-service DB (MySQL) ---
TESORERIA_DB_NAME=tesoreria_service
TESORERIA_DB_USER=tesoreria_app
TESORERIA_DB_PASSWORD=change-me
TESORERIA_DB_ROOT_PASSWORD=change-me-root
TESORERIA_DB_HOST=tesoreria-service-db
TESORERIA_DB_PORT=3306

# --- rentas-service DB (MySQL) ---
RENTAS_DB_NAME=rentas_service
RENTAS_DB_USER=rentas_app
RENTAS_DB_PASSWORD=change-me
RENTAS_DB_ROOT_PASSWORD=change-me-root
RENTAS_DB_HOST=rentas-service-db
RENTAS_DB_PORT=3306

# --- document-intelligence-service DB (MySQL) ---
DOCINT_DB_NAME=docint_service
DOCINT_DB_USER=docint_app
DOCINT_DB_PASSWORD=change-me
DOCINT_DB_ROOT_PASSWORD=change-me-root
DOCINT_DB_HOST=document-intelligence-service-db
DOCINT_DB_PORT=3306

# --- Login OIDC real (Google Workspace) - iam-service ---
# Client ID/Secret del cliente OAuth "iam-service-oidc" (Google Auth
# Platform > Clientes) - los mismos valores que ya estan en Secret Manager
# como OIDC_CLIENT_ID/OIDC_CLIENT_SECRET (ver
# docs/architecture/infraestructura-gcp/oidc-login.md).
OIDC_CLIENT_ID=change-me.apps.googleusercontent.com
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:8080/iam/auth/google/callback
OIDC_APPROVED_DOMAINS=cypcumbres.mx
OIDC_FRONTEND_SUCCESS_URL=http://localhost:3000/
OIDC_FRONTEND_ERROR_URL=http://localhost:3000/login?error=oidc

# --- Motor de Procesamiento Documental (Gemini) ---
# DOCINT_USE_VERTEX=False (default): usa AI Studio, SOLO documentos ficticios
# de prueba (el tier gratis puede usar los prompts para entrenar modelos).
# DOCINT_USE_VERTEX=True: usa Vertex AI, requiere proyecto GCP - unico modo
# permitido para documentos reales de PLD/KYC.
DOCINT_USE_VERTEX=False
GEMINI_API_KEY=
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# --- drive-service (Google Drive, docs/architecture/pld-fase2-alcance.md sec. 1.4) ---
# Vacio (default) => driveclient.py cae en modo simulado (carpeta local en
# disco, ver services/drive-service/drive/driveclient.py) - permite
# desarrollar/probar sin la cuenta de servicio real. Cuando exista la
# credencial real, pegar aqui el JSON completo de la cuenta de servicio
# (mismo secreto DRIVE_SERVICE_ACCOUNT_JSON de Secret Manager en Cloud Run).
DRIVE_SERVICE_ACCOUNT_JSON=
# Correo del Workspace de Cumbres a impersonar via domain-wide delegation
# (la cuenta de servicio no tiene Drive propio) - debe ser dueno/tener
# acceso a la Unidad compartida CumbresBI.
DRIVE_IMPERSONATE_SUBJECT=
# ID de la carpeta raiz "CumbresBI/" en Drive (Unidad compartida ya creada,
# ver memoria de sesion "drive-estructura-carpetas-grupos" - carpetas raiz
# por modulo: RRHH/, Vivienda/, Compras/, Tesoreria/). Fallback para
# modulos que aun no tienen su propia Unidad compartida.
DRIVE_ROOT_FOLDER_ID=
# Mapeo modulo -> ID de su propia Unidad compartida (JSON), para modulos ya
# migrados fuera de CumbresBI/ (ver memoria "drive-grupos-automatizacion-
# permisos" - PLD fue el primero, 14/Ago/2026). Ej:
# DRIVE_MODULE_FOLDER_IDS={"PLD": "<id_unidad_compartida_PLD>"}
DRIVE_MODULE_FOLDER_IDS={}
# Secreto compartido servicio-a-servicio (drive-service + pld-service, ver
# comentario en ambos config/settings.py) - autoriza a subir_documento()
# (formulario publico de PldTicketCliente, sin JWT de usuario) a subir a
# Drive sin exigir un perm_key de sesion. Vacio en dev = bypass deshabilitado
# en ambos lados (nadie puede usarlo hasta configurarlo explicitamente).
DRIVE_INTERNAL_SECRET=

# --- mail-service (Gmail API, envio real de Magic Links / tickets de cliente) ---
# Vacio (default) => gmailclient.py cae en modo simulado (solo registra el
# correo en el log, no lo manda de verdad, ver services/mail-service/mail/
# gmailclient.py) - permite desarrollar/probar sin la cuenta real todavia.
GMAIL_SERVICE_ACCOUNT_JSON=
# Correo del Workspace de Cumbres a impersonar via domain-wide delegation Y
# remitente real de los correos (ej. notificaciones@cypcumbres.mx).
GMAIL_SENDER_SUBJECT=

# --- Formulario publico de KYC externo (pld-ticket/[token], docs/architecture/pld-fase2-alcance.md sec. 2) ---
# Site key: publica por diseno (va en el HTML del formulario), se usa en
# el frontend para renderizar el widget de reCAPTCHA v2.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Secret key: SOLO server-side (pld-service), verifica el token contra la
# API de Google. Vacio en dev => modo simulado (ver pld/recaptcha.py),
# acepta cualquier token no vacio para poder probar sin cuenta real.
RECAPTCHA_SECRET_KEY=
