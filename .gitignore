# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
build/
dist/
*.egg

# --- Django ---
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
staticfiles/
media/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Env files (never commit secrets) ---
.env
.env.*
!.env.example

# --- Docker ---
docker-compose.override.yml

# --- Database volumes / dumps ---
**/mysql-data/
*.sql.gz
*.dump

